{
  "name": "network-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive network-engineer portfolio — React 18 + Vite + Tailwind + Framer Motion + Canvas 2D topology.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
